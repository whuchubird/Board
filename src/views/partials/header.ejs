<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="생각과 이야기를 나누는 커뮤니티 게시판">
  <title><%= title %> | 모두의 게시판</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Pretendard:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="shell nav-wrap">
      <a class="brand" href="/posts" aria-label="모두의 게시판 홈">
        <span class="brand-mark" aria-hidden="true">文</span>
        <span>모두의 게시판</span>
      </a>
      <nav class="nav" aria-label="주요 메뉴">
        <% if (currentUser) { %>
          <span class="welcome"><strong><%= currentUser.username %></strong>님</span>
          <a class="button button-primary button-small" href="/posts/new">새 글</a>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button-ghost button-small" type="submit">로그아웃</button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/login">로그인</a>
          <a class="button button-primary button-small" href="/register">회원가입</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="shell main-content">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
