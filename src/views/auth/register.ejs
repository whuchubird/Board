<%- include('../partials/header') %>
<section class="auth-layout">
  <div class="auth-copy">
    <p class="eyebrow">JOIN THE COMMUNITY</p>
    <h1>당신의 첫<br>이야기를 들려주세요.</h1>
    <p>간단한 가입 후 바로 글을 작성할 수 있습니다.</p>
  </div>
  <form class="card form-card" action="/register" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>회원가입</h2>
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <label for="username">아이디</label>
    <input id="username" name="username" type="text" value="<%= values.username || '' %>" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" autocomplete="username" required autofocus>
    <p class="field-hint">영문, 숫자, 밑줄 조합 3~30자</p>
    <label for="password">비밀번호</label>
    <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
    <p class="field-hint">8자 이상 입력해 주세요.</p>
    <button class="button button-primary button-wide" type="submit">가입하기</button>
    <p class="form-foot">이미 계정이 있나요? <a href="/login">로그인</a></p>
  </form>
</section>
<%- include('../partials/footer') %>
